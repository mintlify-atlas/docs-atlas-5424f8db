{
  "$schema": "https://mintlify.com/docs.json",
  "name": "@nuxt-alt/auth",
  "theme": "luma",
  "colors": {
    "primary": "#00DC82",
    "light": "#ECFDF5",
    "dark": "#003521"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/nuxt-alt/auth"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/nuxt-alt/auth"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "installation",
              "quickstart"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/module-options",
              "configuration/storage",
              "configuration/redirects"
            ]
          },
          {
            "group": "Schemes",
            "pages": [
              "schemes/local",
              "schemes/refresh",
              "schemes/cookie",
              "schemes/oauth2",
              "schemes/openid-connect"
            ]
          },
          {
            "group": "Providers",
            "pages": [
              "providers/overview",
              "providers/auth0",
              "providers/github",
              "providers/google",
              "providers/facebook",
              "providers/discord",
              "providers/laravel-sanctum",
              "providers/laravel-passport",
              "providers/laravel-jwt"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/middleware",
              "guides/composable",
              "guides/typescript",
              "guides/ssr",
              "guides/migration"
            ]
          }
        ]
      }
    ]
  }
}
